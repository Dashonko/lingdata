    <TIER ANNOTATOR="@dac2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_organs"
        PARENT_REF="gestType@vvb2008f" PARTICIPANT="@vvb2008f" TIER_ID="gestLegs@vvb2008f"/>
    <TIER ANNOTATOR="@dac2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@vvb2008f" PARTICIPANT="@vvb2008f" TIER_ID="gestComment@vvb2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a783" ANNOTATION_REF="a637">
                <ANNOTATION_VALUE>не совсем понимаю, что тут писать в значении,  она будто аргументирует то, что сказала до этого, но при  этом показывает неуверенность</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a784" ANNOTATION_REF="a623">
                <ANNOTATION_VALUE>здесь она делает акцент на слове "домашний" однако это не похоже на изобразительный жест, поэтому не понимаю, что писать. ну и насчёт движения, вроде тут не только кисти участвуют, на всякий случай выделила arms тк предплечье двигается и fingers тк пальцы разгибаются</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a843" ANNOTATION_REF="a624">
                <ANNOTATION_VALUE>немного меняется положение головы, решила её выделить</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a844" ANNOTATION_REF="a625">
                <ANNOTATION_VALUE>не понимаю двигаются ли тут кисти, решила не выделять</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a845" ANNOTATION_REF="a652">
                <ANNOTATION_VALUE>здесь вроде двигаются только пальцы, а кисти нет, не стала выделять</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a627">
                <ANNOTATION_VALUE>она немного двигает пальцем, решила тоже выделить + у неё двигаются глаза из-за того что она задумалась</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a785" ANNOTATION_REF="a653">
                <ANNOTATION_VALUE>здесь она снова говрит о себе и делает это улыбаясь, поэтому думаю это показывает ещё и дружелюбие</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a791" ANNOTATION_REF="a787">
                <ANNOTATION_VALUE>небольшое движение пальцев и головы, решила выделить</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a786" ANNOTATION_REF="a714">
                <ANNOTATION_VALUE>положение её рук немного меняется когда она меняет интонацию</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a793" ANNOTATION_REF="a630">
                <ANNOTATION_VALUE>судя по союзу "но" она хочет сказать, что несмотря на то что у неё хорошие соседки, ей всё равно бывает тяжело</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a795" ANNOTATION_REF="a720">
                <ANNOTATION_VALUE>небольшое движение рук будто ставит акцент на этом кусочке записи вместе с интонацией, кистями она не двигает, поэтому их не выделяла</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a799" ANNOTATION_REF="a631">
                <ANNOTATION_VALUE>не знаю точно, какое тут значение, как будто в этом жесте особо нет смысла, он просто выражает спокойствие во время разговора. пальцы выделила тк они немного сгибаются при движении</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a798" ANNOTATION_REF="a650">
                <ANNOTATION_VALUE>она немного двигает головой, поэтому выделила её тоже +пальцы немного двигаются в конце, выделила их</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a801" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>мне кажется она до этого оговорилась, а сейчас более уверенно сказала, как бы "поправила себя"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a804" ANNOTATION_REF="a638">
                <ANNOTATION_VALUE>мне кажется тут она соглашается сама с собой, со своей мыслью. кисти немного меняют положение, выделила их</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a806" ANNOTATION_REF="a639">
                <ANNOTATION_VALUE>она немного двигает большим пальцем, мне кажется она настраивает себя на разговор</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a807" ANNOTATION_REF="a654">
                <ANNOTATION_VALUE>я не понимаю как правильно написать здесь значение, она как бы говорит "хорошо", то есть соглашается, но я не уверена</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a808" ANNOTATION_REF="a632">
                <ANNOTATION_VALUE>то же самое, что в предыдущем комментарии</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a809" ANNOTATION_REF="a655">
                <ANNOTATION_VALUE>немного перебирает пальцы, решила выделить</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a810" ANNOTATION_REF="a633">
                <ANNOTATION_VALUE>то же самое, что и в прошлом комментарии</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a814" ANNOTATION_REF="a634">
                <ANNOTATION_VALUE>она делает всё в такт своим словам, поэтому поставила тут такое значение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a818" ANNOTATION_REF="a658">
                <ANNOTATION_VALUE>снова руки немного двигаются в такт словам</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a819" ANNOTATION_REF="a641">
                <ANNOTATION_VALUE>мне кажется то, что она двигает пальцами помогает ей более правильно выразить свою мысль, то есть этим жестом она неосознанно себя направляет на определенные размышления</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a829" ANNOTATION_REF="a824">
                <ANNOTATION_VALUE>мне кажется тут она просто говорит факт </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a831" ANNOTATION_REF="a646">
                <ANNOTATION_VALUE>здесь мне кажется она имела в виду "хотела ли ты чего-то бОльшего, великого" поэтому тут я думаю что жест изобразительный</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a833" ANNOTATION_REF="a660">
                <ANNOTATION_VALUE>тут она хочет заменить прошлые слова и делает на этом акцент руками, под обнулением я подразумеваю отсечение предыдущих слов</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a835" ANNOTATION_REF="a647">
                <ANNOTATION_VALUE>тут она, перебирая пальцы, помогает себе в процессе разговора оставаться сконцентрированной</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a837" ANNOTATION_REF="a635">
                <ANNOTATION_VALUE>тут она как будто пропускает слово "крутыми", заменяя его жестом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
