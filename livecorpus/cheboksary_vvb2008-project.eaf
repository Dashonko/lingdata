        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4274" ANNOTATION_REF="a4272">
                <ANNOTATION_VALUE>в данном контексте это указательный жест ведь она говорит о конкретном месте, которое до этого фигурировало в её рассказе как точка назначения путь к которой она показывала. пальцы неподвижны, тело немного наклонилось</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4292" ANNOTATION_REF="a4281">
                <ANNOTATION_VALUE>не уверена, но вроде она именно изображает слово "через"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4439" ANNOTATION_REF="a4300">
                <ANNOTATION_VALUE>жест соотновится с ритмом речи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4335" ANNOTATION_REF="a4330">
                <ANNOTATION_VALUE>двигается в такт словам</ANNOTATION_VALUE>
