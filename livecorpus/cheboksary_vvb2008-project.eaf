    <TIER ANNOTATOR="@dac2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@vvb2008f" PARTICIPANT="@vvb2008f" TIER_ID="gestComment@vvb2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3754" ANNOTATION_REF="a3747">
                <ANNOTATION_VALUE>немного пошевелились пальцы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3762" ANNOTATION_REF="a3755">
                <ANNOTATION_VALUE>этим жестом она неспециально показывает удивление. скорее её тело бесконтрольно реагирует на неожиданную фразу. думаю это адаптор</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3771" ANNOTATION_REF="a3763">
                <ANNOTATION_VALUE>жест кажется менее осознанным и активным чем предыдущий, она собирается с мыслями. я не вижу в нём особого значения</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3833" ANNOTATION_REF="a3782">
                <ANNOTATION_VALUE>жест выглядит неосознанным, но он показывает внутреннее состояние поэтомы выделаю как прагматический</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3834" ANNOTATION_REF="a3788">
                <ANNOTATION_VALUE>то же самое</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3831" ANNOTATION_REF="a3829">
                <ANNOTATION_VALUE>движение головы и рук сочетается с интьонацией </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3841" ANNOTATION_REF="a3835">
                <ANNOTATION_VALUE>она обращается к своему воображению и неосознанно покачивает головой из-за неуверенности. думаю это прагматический жест с элементами адаптора. руки немного двинулись в начале, отметила их</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3848" ANNOTATION_REF="a3842">
                <ANNOTATION_VALUE>очень резкий жест, она будто специально показывает слово "быстро" или "резко" или что-то такое. мне кажется он слишком хорошо изображает слово фигурирующее в речи для прагматического, поэтому отмечаю его как изобразительный</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3856" ANNOTATION_REF="a3849">
                <ANNOTATION_VALUE>жест показывает её готовность и уверенность в своих словах</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3862" ANNOTATION_REF="a3857">
                <ANNOTATION_VALUE>она образно показывает целое предложение жестами, делая акцент на "последний день" как на главном условии</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3871" ANNOTATION_REF="a3863">
                <ANNOTATION_VALUE>немного двигает головой, её выделила. адаптор потому что нет особого посыла, она просто на секунду задумалась</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3890" ANNOTATION_REF="a3882">
                <ANNOTATION_VALUE>немного двигались пальцы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3897" ANNOTATION_REF="a3891">
                <ANNOTATION_VALUE>она прокручивает в голове гипотетическую ситуацию и думает, что сказала бы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3905" ANNOTATION_REF="a3898">
                <ANNOTATION_VALUE>"по возможности" подсказывает её желание встретить друзей. то есть она надеется что это будет возможным. мне кажется из-за этого её руки неосознанно сложились именно так. тело немного двигается</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3912" ANNOTATION_REF="a3906">
                <ANNOTATION_VALUE>немного двигается голова поэтому выделила её. этим жестом она показывает свою уверенность и готовность встретиться с друзьями. она как бы составляет план действий</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3919" ANNOTATION_REF="a3913">
                <ANNOTATION_VALUE>делает акцент на том что они в разных местах. показывает их "разбросанность"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3926" ANNOTATION_REF="a3920">
                <ANNOTATION_VALUE>акцент на слове "поэтому". немного дёрнулась голова в конце</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3935" ANNOTATION_REF="a3927">
                <ANNOTATION_VALUE>своим жестом она создаёт конраст с негативным смыслом фразы. как бы наклоняется к собеседнику с улыбкой, смягчая неприятный факт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3938" ANNOTATION_REF="a3936">
                <ANNOTATION_VALUE>я считаю что этот жест можно считать так же изобразительным, но тут больше акцент на саму структуру мысли, поэтому тип прагматический</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3950" ANNOTATION_REF="a3943">
                <ANNOTATION_VALUE>она разделяет части высказывания "если...то"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3955" ANNOTATION_REF="a3947">
                <ANNOTATION_VALUE>мне кажется что наклон головы тоже входит в этот жест ведь отдельного смысла он в себе не несёт, она просто пытается успокоить себя и настроить на продолжение разговора</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3962" ANNOTATION_REF="a3956">
                <ANNOTATION_VALUE>немного двигается голова в конце. значение выбрала исходя из слова "как-то" она будто не знает как сформулировать мысль и пытается найти нужное слово</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3968" ANNOTATION_REF="a3963">
                <ANNOTATION_VALUE>её будто пугает ситуация и она неосознанно испытывает страх</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3975" ANNOTATION_REF="a3970">
                <ANNOTATION_VALUE>=хорошо</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3988" ANNOTATION_REF="a3980">
                <ANNOTATION_VALUE>немного двигаются пальцы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3989" ANNOTATION_REF="a3987">
                <ANNOTATION_VALUE>немного кивнула. тут мне кажется недостаточно для эмблемы. она больше даёт собеседнику понять что услышала его чем соглашается</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4008" ANNOTATION_REF="a4001">
                <ANNOTATION_VALUE>этим большим жестом она как бы изображает расстояние от одного условного объекта в пространстве до другого. тк она не опирается на реальное местонахождение объектов в этом жесте, я не могу назвать его указательным</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4015" ANNOTATION_REF="a4009">
                <ANNOTATION_VALUE>заканчиваня говорить она спокойно возвращает руки в нейтральное положение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4024" ANNOTATION_REF="a4018">
                <ANNOTATION_VALUE>она успокаивает себя после сильного удивления. голова немного двигается, выделила её</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4035" ANNOTATION_REF="a4033">
                <ANNOTATION_VALUE>она вспомнила корпус  и уточняет у собеседника правильно ли</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4056" ANNOTATION_REF="a4036">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4049" ANNOTATION_REF="a4042">
                <ANNOTATION_VALUE>тело немного наклонила</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4055" ANNOTATION_REF="a4050">
